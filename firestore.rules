rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Artisans & their products
    match /artisans/{artisanId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == artisanId;

      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == artisanId;
      }
    }

    // Top-level products collection for instant marketplace feed
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Collection group query for marketplace products
    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // Social follow network
    match /artisans/{artisanId}/followers/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{userId}/following/{artisanId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders collection for marketplace checkout
    match /orders/{orderId} {
      allow read, create, update: if true;
    }

    // User profiles & user orders
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
